{
  "manifest_version": 3,
  "name": "Linkscope",
  "version": "1.0.0",
  "description": "Linkscope scans every site you visit in real time, detecting phishing, lookalike domains, and suspicious redirects before you're exposed to them.",
  "permissions": [
    "storage",
    "tabs",
    "notifications",
    "webNavigation",
    "activeTab",
    "contextMenus",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content/contentScript.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "src/background/worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": "icons/icon48.png"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}